# ---------------------------------------------------------------------------
# Template. Copy to .env.local (development) or .env.production (deployment).
# APP_ENV selects which file is loaded: APP_ENV=local -> backend/.env.local
# Never commit a file containing real secrets.
# ---------------------------------------------------------------------------

APP_ENV=local
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Authentication ---------------------------------------------------------
# Signing key for access/refresh tokens. Falls back to SECRET_KEY when blank;
# set it separately in production.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
MIN_PASSWORD_LENGTH=8
# Wrong passwords in a row before an account is locked, and for how long.
# An admin password reset lifts the lock early.
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15
# Lifetime of the signed state sent through LinkedIn's OAuth redirect.
OAUTH_STATE_EXPIRE_MINUTES=10

# Set false to close public sign-up; admins can still create accounts.
ALLOW_REGISTRATION=true
# Turn on when email delivery is wired up. New accounts then land in
# PENDING_VERIFICATION and cannot sign in until the emailed token is confirmed.
# No migration is needed to flip this: the token is issued either way.
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TOKEN_HOURS=48

# First administrator, seeded on startup only while the users table is empty.
# Leave ADMIN_PASSWORD blank to skip seeding and use:
#   python -m scripts.create_admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator

# --- Database ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=linkedin_agent
DB_SCHEMA=linkedin_agent
DB_ECHO=false
# Set DATABASE_URL to override the pieces above entirely.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/linkedin_agent

# --- Redis / Celery ---------------------------------------------------------
# The compose Redis requires a password: redis://:<REDIS_PASSWORD>@localhost:6379/0
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false

# --- LLM provider -----------------------------------------------------------
# claude | local | mock
LLM_PROVIDER=claude
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=120

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=4096

LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen3
LOCAL_LLM_SUPPORTS_STRUCTURED_OUTPUT=true
LOCAL_LLM_MAX_CONTEXT_TOKENS=32768

# --- Prompt versions --------------------------------------------------------
CAMPAIGN_PARSER_PROMPT_VERSION=v1
CANDIDATE_EVALUATOR_PROMPT_VERSION=v1
POST_EVALUATOR_PROMPT_VERSION=v1
COMMENT_GENERATOR_PROMPT_VERSION=v1
CONNECTION_GENERATOR_PROMPT_VERSION=v1

# --- Agent behaviour --------------------------------------------------------
DRY_RUN=true
# mock | linkedin | brightdata | unipile | composite
PLATFORM_ADAPTER=mock
CONNECTION_DELAY_HOURS=48

MAX_PEOPLE_PER_DAY=20
MAX_LIKES_PER_DAY=60
MAX_COMMENTS_PER_DAY=15
MAX_CONNECTIONS_PER_DAY=15
MAX_PEOPLE_PER_RUN=5

MIN_ACTION_DELAY_SECONDS=30
MAX_ACTION_DELAY_SECONDS=180

INITIAL_POSTS_TO_LIKE=2
EVALUATED_POST_INDEX=3
MINIMUM_RELEVANCE_SCORE=75

MAX_ACTION_ATTEMPTS=3
WORKFLOW_FAILURE_THRESHOLD=3

# --- Platform: Bright Data (data only, no account risk) ---------------------
# Read-only LinkedIn data. Never touches your LinkedIn account.
# Signup needs a company email domain and a business registration document.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_BASE_URL=https://api.brightdata.com
# Dataset ids from the Web Scraper API dashboard.
BRIGHTDATA_DATASET_PROFILE=gd_l1viktl72bvl7bjuj0
BRIGHTDATA_DATASET_POSTS=gd_lyy3tktm25m4avu764
# Leave blank unless you have a dataset that filters by title/industry/location.
# The scraper API's own people discovery matches on name only.
BRIGHTDATA_DATASET_PEOPLE_SEARCH=
BRIGHTDATA_POLL_INTERVAL_SECONDS=5
BRIGHTDATA_POLL_TIMEOUT_SECONDS=1800
BRIGHTDATA_MAX_POSTS_PER_PERSON=10
BRIGHTDATA_POST_LOOKBACK_DAYS=60

# --- Platform: Unipile (engagement) -----------------------------------------
# Acts through YOUR LinkedIn session, so it inherits that account's limits and
# LinkedIn's User Agreement applies to you. A free LinkedIn account allows only
# ~5 invitations/month; Premium or Sales Navigator is effectively required.
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
# classic | sales_navigator | recruiter  (sales_navigator 403s without a seat)
UNIPILE_SEARCH_API=classic
UNIPILE_TIMEOUT_SECONDS=60

# --- Unipile hosted auth (connecting YOUR USERS' LinkedIn accounts) ---------
# Each user connects their own LinkedIn through Unipile's hosted wizard, so
# their password never reaches this application. Needed for that flow:
#
# Frontend origin the wizard returns the browser to.
APP_BASE_URL=http://localhost:5173
# PUBLIC origin of this API. Unipile calls it server-to-server, so localhost
# will not work: use a tunnel (ngrok, Cloudflare Tunnel) during development.
# Leave blank to disable linking with a clear error rather than issuing links
# whose callback can never arrive.
PUBLIC_API_BASE_URL=
# Random string forming part of the webhook path. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
UNIPILE_WEBHOOK_SECRET=
UNIPILE_HOSTED_AUTH_EXPIRY_MINUTES=15

# --- Platform: composite ----------------------------------------------------
# Set PLATFORM_ADAPTER=composite to read with one adapter and write with
# another. Recommended: Bright Data reads (high volume, no account exposure),
# Unipile writes (a handful of deliberate actions).
COMPOSITE_READ_ADAPTER=brightdata
COMPOSITE_WRITE_ADAPTER=unipile

# --- LinkedIn OAuth (only needed when PLATFORM_ADAPTER=linkedin) ------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5173/auth/callback
# Supplied at runtime by the OAuth flow; never commit a real token.
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_REFRESH_TOKEN=

# --- Cloudflare Turnstile Anti-Bot Protection -------------------------------
# In local dev and tests, defaults to Cloudflare's official testing keys
# (1x0000000000000000000000000000000AA). Set real keys in staging/production.
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# --- Payments & Billing (Multi-Gateway: Stripe & Razorpay) -----------------
DEFAULT_PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Price IDs generated in Stripe Dashboard
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_ANNUAL=

# Optional Razorpay configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
